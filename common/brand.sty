%% brand.sty — the visual identity, defined once for every deliverable.
%% Palette tokens, a TikZ mark, a wordmark and a lockup. Class-agnostic: no
%% font packages that would clash with acmart, tufte-book or beamer; needs only
%% xcolor, graphicx and tikz. Rename the project in \brandname. Every document
%% picks up the change.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{brand}[2026/09/27 document identity]

\RequirePackage{xcolor}
\RequirePackage{tikz}
\usetikzlibrary{calc,arrows.meta,positioning,decorations.text}
\RequirePackage{graphicx}

%% ---- The name ------------------------------------------------------------
\providecommand{\brandname}{project}

%% ---- Palette -------------------------------------------------------------
%% Ink on warm paper, a deep-teal primary, an amber accent.
\definecolor{brandInk}{HTML}{14181F}      % text, spine
\definecolor{brandPrimary}{HTML}{2F6F6A}  % primary
\definecolor{brandSecondary}{HTML}{4E8F86}% secondary
\definecolor{brandAccent}{HTML}{E0A21A}   % highlight
\definecolor{brandPaper}{HTML}{FBFAF7}    % background
\definecolor{brandMuted}{HTML}{6B7280}    % secondary text, rules

%% ---- The mark ------------------------------------------------------------
%% The author's logo: "evolutivo" and "iterativo" following each other along a
%% lemniscate, each character scaled by cos^2 of its position so the words
%% shrink toward the crossing, like a Moebius strip seen edge-on. The drawing
%% is the author's original, unchanged; the optional argument only sets the
%% width it is scaled to (default 4cm, its natural size). The lettering is
%% pinned to the original's typeface, T1 Palatino at 11pt, so the mark looks
%% the same whatever font the host document uses.
\newcommand{\brandmarkpicture}{%
  {\fontencoding{T1}\fontfamily{ppl}\fontseries{m}\fontshape{n}%
   \fontsize{11pt}{13.6pt}\selectfont
  \begin{tikzpicture}[decoration={text effects along path,
      text={evolutivoiterativoevolutivoiterativo},
      text effects/.cd,
      repeat text,
      character count=\m, character total=\n,
      characters={text along path, scale=.5+.39*cos(180*\m/\n)*cos(180*\m/\n)}}]
    \path [postaction=decorate, domain=90:446, samples=200]
      plot ({2*cos(\x)}, {2*sin(\x)*cos(\x)});
  \end{tikzpicture}}%
}
\newcommand{\brandmark}[1][4cm]{\resizebox{#1}{!}{\brandmarkpicture}}

%% ---- The wordmark and lockup ---------------------------------------------
\newcommand{\brandwordmark}{{\sffamily\bfseries\color{brandInk}\brandname}}
\newcommand{\brandlogo}[1][3cm]{%
  \raisebox{-0.4\height}{\brandmark[#1]}\hspace{0.6em}{\Large\brandwordmark}%
}

\endinput
