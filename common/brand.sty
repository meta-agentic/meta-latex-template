%% brand.sty — the visual identity, defined once for every deliverable.
%% Palette tokens, a TikZ mark, a wordmark and a lockup. Class-agnostic: no
%% font packages that would clash with acmart, tufte-book or beamer; needs only
%% xcolor, graphicx and tikz. Rename the project in \brandname. Every document
%% picks up the change.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{brand}[2026/09/27 document identity]

\RequirePackage{xcolor}
\RequirePackage{tikz}
\usetikzlibrary{calc,arrows.meta,positioning}

%% ---- The name ------------------------------------------------------------
\providecommand{\brandname}{project}

%% ---- Palette -------------------------------------------------------------
%% Ink on warm paper, a deep-teal primary, an amber accent.
\definecolor{brandInk}{HTML}{14181F}      % text, spine
\definecolor{brandPrimary}{HTML}{2F6F6A}  % primary
\definecolor{brandSecondary}{HTML}{4E8F86}% secondary
\definecolor{brandAccent}{HTML}{E0A21A}   % highlight
\definecolor{brandPaper}{HTML}{FBFAF7}    % background
\definecolor{brandMuted}{HTML}{6B7280}    % secondary text, rules

%% ---- The mark ------------------------------------------------------------
%% The author's logo: the Latin participles "evolvens iterans" (unfolding,
%% repeating) running around a lemniscate as one closed ribbon. Each letter is
%% scaled by cos^2 of its place in the loop, so the ribbon reads as passing
%% behind itself; where the front strand crosses the back one, its letters are
%% drawn again on top with a halo in the paper colour. Six whole repetitions
%% are fitted to one full turn, so the last letter meets the first with no gap.
%% The lettering is T1 Palatino at 11pt whatever the host document's font. The
%% optional argument is the width it is scaled to (default 4cm, natural size).
%% Derived from the "Ghirlanda" (\braid) of the author's 2017 thesis.
\RequirePackage{graphicx}
\RequirePackage[outline]{contour}
\usetikzlibrary{decorations.text}
\newcommand{\brand@ribbon}[1]{%
  \path [decoration={text effects along path,
      text={evolvensiteransevolvensiteransevolvensiteransevolvensiteransevolvensiteransevolvensiterans},
      text effects/.cd, fit text to path,
      character count=\m, character total=\n,
      characters={text along path, scale=.5+.39*cos(180*(\m/\n))*cos(180*(\m/\n))}#1},
      postaction=decorate, domain=91:451, samples=200]
    plot ({2*cos(\x)}, {2*sin(\x)*cos(\x)});}
% halo colour: the page behind the mark (a slide theme sets its paper colour)
\providecommand{\brandmarkhalo}{white}
%% second pass: only the first and the last letter, haloed, drawn on top
\newcommand{\brand@front}[1]{%
  \pgfmathtruncatemacro{\brand@remaining}{\n-\m}%
  \ifnum\m>1\relax
    \ifnum\brand@remaining<1\relax\contour{\brandmarkhalo}{#1}\else\phantom{#1}\fi
  \else\contour{\brandmarkhalo}{#1}\fi}
\newcommand{\brandmarkpicture}{%
  {\fontencoding{T1}\fontfamily{ppl}\fontseries{m}\fontshape{n}%
   \fontsize{11pt}{13.6pt}\selectfont\contourlength{0.7pt}%
   \begin{tikzpicture}
     \brand@ribbon{}%
     \brand@ribbon{,character command=\brand@front}%
   \end{tikzpicture}}}
\newcommand{\brandmark}[1][4cm]{\resizebox{#1}{!}{\brandmarkpicture}}

%% ---- The wordmark and lockup ---------------------------------------------
\newcommand{\brandwordmark}{{\sffamily\bfseries\color{brandInk}\brandname}}
\newcommand{\brandlogo}[1][3cm]{%
  \raisebox{-0.4\height}{\brandmark[#1]}\hspace{0.6em}{\Large\brandwordmark}%
}

\endinput
